*.swp

# OBS: the live obs-studio dir is symlinked here, so OBS writes logs, caches,
# plugins, and the obs-websocket password into obs/<res>/ too. Track only the
# portable config and ignore everything else OBS drops in.
obs/*/*
!obs/*/global.ini
!obs/*/user.ini
!obs/*/basic/
obs/*/basic/**/*.bak

# Transient sidecar from setup.sh's scene re-smudge; only ever present mid-run.
obs/*/basic/scenes/*.resmudge.*

# Kept, not transient: the re-smudge backs a clobbered config up here rather
# than destroying it, and those bytes are exactly the ones holding a username.
obs/*/basic/**/*.backup.*
