# Expected colour-transition sequence for the 'detached-head' prompt state.
#
# No branch to name, so the short SHA takes its place -- agnoster does the
# same. check-prompt.sh rewrites the fixture's commit id to <sha>, since a
# real one differs every run.
#
# THIS FILE IS THE SPEC. Nothing re-derives it at test time. To change how
# the prompt looks, edit this file and starship.toml in the same commit.
#
# Provenance: derived once from zsh/agnoster.zsh-theme at f663cdc.
# Format: fg=<0-7|None> bg=<0-7|None> <python-repr of the visible text>
fg=0 bg=4 ' ~/code/conf '
fg=4 bg=2 ''
fg=0 bg=2 '  <sha> '
fg=2 bg=None ''
